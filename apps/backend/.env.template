# Template for apps/backend env files.
# The API loads .env.<WORKCRATE_ENV> (see scripts/unix|windows and internal/platform/config).
# Copy and adjust into .env.development and .env.production as needed.

# development | production (must match the file suffix scripts set)
WORKCRATE_ENV=development

# HTTP listen address for cmd/api
WORKCRATE_HTTP_ADDR=:8080
